# ===================================================
# Library Digitization System - Environment Config
# Thư viện Đại học Hải Phòng
# ---------------------------------------------------
# Copy file này thành .env rồi điền giá trị thật.
# TUYỆT ĐỐI KHÔNG commit file .env chứa giá trị thật lên git.
# ===================================================

# ============ GENERAL SETTINGS ============
TIMEZONE=Asia/Ho_Chi_Minh
ADMIN_EMAIL=library-admin@hpu.edu.vn

# Thư mục lưu dữ liệu job số hóa (bind mount vào container)
DIGITIZE_DATA_DIR=/data/digitization/jobs

# ============ URL CÔNG KHAI (qua Caddy) ============
# URL mà TRÌNH DUYỆT dùng. Phải khớp với block trong Caddyfile của máy chủ trung tâm.
# ⚠️ Đổi hai biến này thì PHẢI BUILD LẠI UI (`docker compose up -d --build ui`) — Next.js nhúng
# NEXT_PUBLIC_* vào bundle lúc build, restart không đổi được.
PUBLIC_BASE_URL=https://sohoa.hpu.edu.vn
PUBLIC_API_URL=https://sohoa.hpu.edu.vn/ocr-api

# ============ TÀI NGUYÊN & CỔNG (khớp với máy chủ thật) ============
# ⚠️ WORKER_REPLICAS × WORKER_CPUS phải NHỎ HƠN tổng số CPU của máy chủ, nếu không Docker từ chối
# khởi động: "Range of CPUs is from 0.01 to 4.00, as there are only 4 CPUs available".
#   Máy 4 CPU / 8GB   (mặc định): WORKER_REPLICAS=1  WORKER_CPUS=2  WORKER_MEMORY=3G
#   Máy 8 CPU / 16GB:             WORKER_REPLICAS=2  WORKER_CPUS=3  WORKER_MEMORY=6G
#   Máy 16 CPU / 32GB:            WORKER_REPLICAS=3  WORKER_CPUS=4  WORKER_MEMORY=8G
WORKER_REPLICAS=1
WORKER_CPUS=2
WORKER_MEMORY=3G

# Cổng công bố ra máy chủ. Mặc định chỉ mở trên loopback (127.0.0.1) vì Caddy đứng trước làm TLS;
# đặt BIND_ADDR=0.0.0.0 nếu cần truy cập trực tiếp từ máy khác (kém an toàn hơn).
BIND_ADDR=127.0.0.1
# ⚠️ UI KHÔNG dùng 3000 — cổng đó đã bị chat.hpu.edu.vn chiếm trên máy chủ trung tâm.
UI_PORT=3200
API_PORT=8000
# PostgreSQL/Redis đổi cổng để không đâm vào instance có thể đã chạy sẵn trên máy chủ.
# Trong mạng Docker, các service vẫn nối qua postgres:5432 / redis:6379 — KHÔNG bị ảnh hưởng.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
# Chỉ dùng khi bật profile extras
GRAFANA_PORT=3201
FILEBROWSER_PORT=8081
N8N_PORT=5678

# ============ N8N CONFIGURATION ============
# URL backend FastAPI mà n8n gọi tới (trong mạng Docker → dùng tên service, không dùng localhost)
LIBRARY_API_URL=http://api:8000
N8N_USER=admin
N8N_PASSWORD=change_me
N8N_HOST=localhost
# Nếu deploy ra ngoài, đổi thành IP hoặc domain của bạn
# VD: N8N_HOST=192.168.1.100 hoặc N8N_HOST=digitize.hpu.edu.vn

# ============ CLAUDE AI API ============
# Lấy API key tại: https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-your-claude-api-key-here

# ============ MODEL PROVIDER (lớp trừu tượng hóa mô hình - YC-MP) ============
# Đổi công cụ mô hình CHỈ bằng biến này, KHÔNG sửa mã (YC-MP-04, YC-MS-06).
# Danh sách đầy đủ: xem scripts/providers/registry.py hoặc chạy:
#   python -m scripts.eval.run_eval --list-providers
#
#   Tại chỗ (dữ liệu KHÔNG ra khỏi trường): ollama | ollama_openai | vllm | llamacpp | lmstudio | tgi
#   Đám mây (dữ liệu ra ngoài):             claude | openai | azure_openai | gemini | openrouter
#                                           | groq | together | deepseek | mistral | moonshot
#                                           | dashscope | openai_compat
#   Bí danh thương hiệu:                    kimi → moonshot, qwen/alibaba → dashscope
#   Bí danh theo chế độ:                    cloud (= CLOUD_PROVIDER) | local (= LOCAL_PROVIDER)
#
# Mặc định 'cloud' = giữ nguyên hành vi hệ đang chạy (Claude).
MODEL_PROVIDER=cloud

# Công cụ đảm nhiệm mỗi chế độ khi định tuyến theo độ nhạy cảm (YC-DR).
# Tài liệu Nội bộ/Nhạy cảm LUÔN đi vào LOCAL_PROVIDER — ràng buộc cứng YC-DR-03, không ghi đè được.
CLOUD_PROVIDER=claude
LOCAL_PROVIDER=ollama

# --- Quy ước chung: <TÊN_CÔNG_CỤ>_BASE_URL / _MODEL / _EMBED_MODEL / _API_KEY ---
# ⚠️ GIẤY PHÉP TRƯỚC, HIỆU NĂNG SAU: rà giấy phép model và điền docs/LICENSES.md TRƯỚC khi tải/dùng.

# Ollama (tại chỗ, dựng nhanh nhất — ADR-002)
OLLAMA_URL=http://localhost:11434
LOCAL_MODEL=qwen2.5:7b
# Model embedding riêng cho RAG (YC-MS-05) — vd bge-m3; để trống = dùng chung model trên
OLLAMA_EMBED_MODEL=

# vLLM (tại chỗ, thông lượng cao, cần GPU)
# VLLM_BASE_URL=http://vllm:8000/v1
# VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# llama.cpp (tại chỗ, nhẹ nhất, chạy CPU)
# LLAMACPP_BASE_URL=http://llamacpp:8080/v1
# LLAMACPP_MODEL=local-model

# Claude (đám mây) — khóa đặt ở mục CLAUDE AI API phía trên
CLOUD_MODEL=

# Các dịch vụ đám mây khác — chỉ điền khi dùng
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# TOGETHER_API_KEY=
# Moonshot AI — Kimi (bí danh MODEL_PROVIDER=kimi). Ngữ cảnh dài, phù hợp tài liệu OCR nhiều trang.
# MOONSHOT_API_KEY=
# MOONSHOT_MODEL=moonshot-v1-32k
# Đổi vùng dữ liệu sang bản Trung Quốc nếu Nhà trường quyết định như vậy:
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# Alibaba DashScope — Qwen bản dịch vụ (bí danh MODEL_PROVIDER=qwen).
# LƯU Ý: Qwen bản MỞ chạy TẠI CHỖ được (OLLAMA_MODEL=qwen2.5:7b) — cân nhắc trước khi dùng dịch vụ.
# DASHSCOPE_API_KEY=
# DASHSCOPE_MODEL=qwen-plus
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   # bản Trung Quốc
# AZURE_OPENAI_BASE_URL=https://<ten-tai-nguyen>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_MODEL=<ten-deployment>      # Azure: TÊN DEPLOYMENT, không phải tên model gốc

# Điểm cuối tương thích OpenAI chưa có trong bảng (dịch vụ trong nước, máy chủ đơn vị khác...)
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_MODEL=
# OPENAI_COMPAT_API_KEY=
# Mặc định an toàn là 'cloud'. CHỈ đặt 'local' nếu điểm cuối nằm trong hạ tầng của Nhà trường —
# giá trị này quyết định tài liệu nhạy cảm có được gửi tới đó hay không (YC-DR-03).
# OPENAI_COMPAT_DEPLOYMENT=cloud

# Chốt an toàn: provider khai báo 'local' mà điểm cuối KHÔNG thuộc dải mạng nội bộ thì hệ thống TỪ CHỐI
# khởi tạo. Chỉ bật biến dưới đây nếu đường truyền đã được kiểm soát (VPN/đường riêng của Nhà trường).
# ALLOW_PUBLIC_LOCAL_ENDPOINT=0

# ============ PIPELINE TRÍCH XUẤT (ADR-008) ============
# Worker trích metadata QUA lớp provider (định tuyến độ nhạy cảm + điểm tin cậy + nhật ký gọi model).
# Đặt 0 để lùi ngay về đường cũ bám Claude — van an toàn vận hành, không cần build lại image.
USE_PROVIDER_LAYER=1

# Dự phòng chéo công cụ: công cụ chính không sẵn sàng → thử lần lượt các công cụ dưới đây.
# CHỈ dự phòng TRONG CÙNG CHẾ ĐỘ: một công cụ tại chỗ chết sẽ KHÔNG BAO GIỜ chuyển sang đám mây
# (ADR-008) — sự cố hạ tầng không được phép âm thầm đổi nơi dữ liệu đi qua.
# Để trống = không dự phòng (và không tốn lần gọi kiểm tra sẵn sàng nào).
LOCAL_FALLBACK_PROVIDERS=
CLOUD_FALLBACK_PROVIDERS=

# Trường có điểm tin cậy dưới ngưỡng này → tài liệu bị đánh dấu cần cán bộ xem lại (YC-CF-04)
LOW_CONFIDENCE_THRESHOLD=0.5

# Ngữ cảnh cho lược đồ context_strategy='full' (vd công văn). Lược đồ Dublin Core LUÔN dùng
# 10 trang / 6000 ký tự như hệ đang chạy — không đổi để không hồi quy (KT-KH).
CONTEXT_FULL_MAX_PAGES=30
CONTEXT_FULL_MAX_CHARS=20000

# Đo bộ nhớ GPU mỗi lần gọi model (YC-MS-07). Cần nvidia-smi; mặc định TẮT để máy không GPU
# khỏi tốn một lần gọi tiến trình con vô ích cho mỗi tài liệu.
METRICS_GPU=0

# ============ DSPACE INTEGRATION ============
# URL của DSpace server
DSPACE_API_URL=https://lib.hpu.edu.vn/rest
DSPACE_BASE_URL=https://lib.hpu.edu.vn

# DSpace API Token (lấy từ DSpace admin)
DSPACE_API_TOKEN=your_dspace_api_token_here

# Collection UUID mặc định để upload tài liệu
# VD: 123e4567-e89b-12d3-a456-426614174000
DSPACE_DEFAULT_COLLECTION=your_collection_uuid_here

# ============ DATABASE (PostgreSQL) ============
POSTGRES_DB=library_digitization
POSTGRES_USER=libraryuser
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres                # tên service trong docker-compose
POSTGRES_PORT=5432                     # mặc định, có thể bỏ qua

# ============ GRAFANA MONITORING ============
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me

# ============ OCR SETTINGS ============
# Ngôn ngữ OCR: vie (Tiếng Việt), eng (English)
OCR_LANGUAGES=vie+eng
OCR_DPI=300
OCR_GPU_ENABLED=true

# ============ PROCESSING SETTINGS ============
# Số worker xử lý đồng thời
MAX_WORKERS=4

# Thời gian timeout cho mỗi file (giây)
PROCESSING_TIMEOUT=600

# Chất lượng JPEG khi optimize (1-100)
JPEG_QUALITY=85

# ============ FILE STORAGE ============
# Thư mục lưu tạm
TEMP_DIR=/tmp/n8n-digitize

# Thư mục output
OUTPUT_DIR=/opt/library-digitization-system/data/output

# ============ LOGGING ============
LOG_LEVEL=INFO
LOG_DIR=/var/log/library-digitization

# ============ REDIS QUEUE ============
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ============ ADVANCED SETTINGS ============
# Kích hoạt AI enhancement (true/false)
AI_ENHANCEMENT_ENABLED=true

# Ngưỡng confidence tối thiểu cho OCR (0-100)
MIN_OCR_CONFIDENCE=70

# Auto-retry khi lỗi
MAX_RETRIES=3

# ============ SECURITY ============
# Secret key cho API (generate random string)
API_SECRET_KEY=your_random_secret_key_here_change_this

# Cho phép CORS từ origins nào
ALLOWED_ORIGINS=http://localhost:5678,http://localhost:3000

# ============ NOTIFICATIONS ============
# Email notifications (optional) - dùng App Password, KHÔNG dùng mật khẩu thật
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@hpu.edu.vn
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=your_email@hpu.edu.vn

# ===================================================
# LOG HỆ THỐNG CÓ CẤU TRÚC (sprint V1 — YC-LG)
# ===================================================
# json = mỗi dòng log là một object JSON, lọc/tổng hợp được, có request_id để lần một request
#        xuyên suốt các tầng. text = van lùi về định dạng chữ thuần như trước.
# ⚠️ Bộ lọc che khóa API/mật khẩu (YC-BM-03) chạy ở CẢ HAI chế độ — đó là cơ chế bảo mật, không
#    phải tùy chọn hiển thị.
LOG_FORMAT=json
LOG_LEVEL=INFO

# Ghi thêm ra tệp JSONL có luân chuyển. Để TRỐNG = chỉ ghi stdout (như trước).
# ⚠️ Phải gắn volume cho thư mục này, nếu không log mất khi container khởi động lại.
LOG_DIR=/data/logs
LOG_ROTATE_MB=100
LOG_ROTATE_KEEP=10

# Thời hạn lưu từng lớp nhật ký (QĐ-08). Khác nhau vì giá trị của từng loại khác nhau:
#   audit_log      VĨNH VIỄN  — nghiệp vụ, bất biến (YC-AU-06), KHÔNG có biến nào dọn được nó
#   user_activity  365 ngày   — hành vi người dùng, phục vụ điều tra an ninh
#   system_events   90 ngày   — sự cố hạ tầng, hết giá trị nhanh sau khi đã xử lý
#   tệp JSONL       14 ngày   — chi tiết kỹ thuật, chỉ dùng khi đang gỡ lỗi
LOG_RETENTION_DAYS=14
SYSTEM_EVENTS_RETENTION_DAYS=90
USER_ACTIVITY_RETENTION_DAYS=365

# Bật/tắt ghi nhật ký hành vi người dùng (sprint V4)
USER_ACTIVITY_ENABLED=1

# ===================================================
# NẠP TÀI LIỆU KHỐI LƯỢNG LỚN (sprint V5 — YC-BU)
# ===================================================
# Hạn mức mỗi lô — thay cho trần cứng 10 tệp của đường nạp cũ.
# Giới hạn CẢ số tệp lẫn tổng dung lượng: 500 tệp nhỏ và 20 tệp 500MB là hai loại tải khác hẳn nhau.
MAX_BATCH_FILES=500
MAX_BATCH_MB=5000

# Chống trùng bằng SHA-256: skip = bỏ qua và báo trùng với tài liệu nào (mặc định)
#                           reprocess = xử lý lại dù đã có
DEDUP_MODE=skip

# Từ chối nhận tài liệu mới khi dung lượng trống dưới ngưỡng này (GB).
# Đĩa đầy giữa lô lớn làm PostgreSQL không ghi được và worker không lưu được — hỏng rất khó gỡ.
DISK_MIN_FREE_GB=20

# Giới hạn tệp ZIP — chống zip bomb (kiểm TRƯỚC khi giải nén, trên siêu dữ liệu)
ZIP_MAX_UNCOMPRESSED_MB=5000
ZIP_MAX_ENTRIES=1000
# PDF vốn đã nén nên tỉ lệ thật thường dưới 5; trên 100 gần như chắc chắn là zip bomb
ZIP_MAX_RATIO=100

# Bao lâu thử lại một tài liệu thuộc lô đang tạm dừng (giây)
BATCH_PAUSE_RECHECK_SEC=30

# Kiểm soát tải (YC-BU-17): từ chối MỀM việc nạp mới khi hàng đợi đã có ngần này tài liệu chờ.
# Đếm cả job đang chờ thử lại — chúng vẫn sẽ quay lại hàng đợi. Đặt 0 để tắt.
QUEUE_MAX_DEPTH=2000

# Chu kỳ lấy mẫu độ sâu hàng đợi cho biểu đồ xu hướng (giây)
QUEUE_SAMPLE_INTERVAL_SEC=60

# ===================================================
# PHÂN TÍCH CHI TIẾT KẾT QUẢ AI (sprint V2 — YC-AN)
# ===================================================
# Ghi kết quả TỪNG TRƯỜNG vào `model_call_fields` — dữ liệu để đo độ chính xác trên việc thật.
# Đặt 0 khi chưa chạy migration 005 hoặc muốn giảm khối lượng ghi (hệ thống chạy y như trước).
AI_ANALYTICS_DETAIL=1
# Cắt ngắn giá trị lưu, để bảng nhật ký không thành bản sao thứ hai của nội dung tài liệu
AI_FIELD_PREVIEW_CHARS=200

# Đo chất lượng OCR sau mỗi tài liệu (số trang, trang KHÔNG có lớp text → cần quét lại)
OCR_METRICS_ENABLED=1
# Trang có ít hơn ngần này ký tự coi như không có lớp text (OCR hay để lại vài ký tự nhiễu)
OCR_MIN_CHARS_PER_PAGE=20

# ⚠️ SỐ QUAN SÁT TỐI THIỂU trước khi được hiển thị tỉ lệ %. Dưới ngưỡng → "chưa đủ dữ liệu".
# Một trường có 3 quan sát mà báo "100% chính xác" là con số gây hiểu nhầm nguy hiểm hơn là
# không có con số nào — và nó sẽ đi thẳng vào hồ sơ dự thi nếu không chặn.
ACCURACY_MIN_SAMPLE=30

# Tỉ giá quy đổi chi phí gọi model sang VNĐ. Báo cáo LUÔN ghi rõ tỉ giá đã dùng, nếu không thì
# con số VNĐ không kiểm chứng lại được. Chế độ tại chỗ luôn = 0 đ.
USD_VND_RATE=25000
# Tệp JSON đè bảng đơn giá model (đơn giá nhà cung cấp thay đổi theo thời gian; đổi mà không sửa mã)
MODEL_PRICING_FILE=

# Lưu prompt và phản hồi THÔ ra tệp riêng. MẶC ĐỊNH TẮT vì nội dung tài liệu có thể nhạy cảm.
AI_LOG_RAW=0

# ===================================================
# HÀNG ĐỢI TIN CẬY (ADR-011 — vá lỗi N-02 "mất job khi worker chết")
# ===================================================
# reliable = BLMOVE + thu hồi việc mồ côi (MẶC ĐỊNH, không mất job)
# blpop    = van lùi về vòng lặp cũ. ⚠️ Chế độ cũ MẤT job nếu worker chết giữa lúc xử lý —
#            chỉ dùng để đối chứng khi gỡ lỗi, không dùng lâu dài.
QUEUE_MODE=reliable

# Số lần thử TỐI ĐA cho lỗi HẠ TẦNG (mất Redis/PostgreSQL...). Lỗi TÀI LIỆU (PDF hỏng) không thử lại.
MAX_ATTEMPTS=3
# Khoảng lùi lần đầu (giây); tăng gấp đôi mỗi lần: 30s → 60s → 120s
RETRY_BACKOFF_SEC=30
# Chu kỳ quét thu hồi job của worker đã chết. Nhịp tim TTL 60s nên không nên đặt lớn hơn nhiều.
RECLAIM_INTERVAL_SEC=60

# ===================================================
# TẢI TỆP (ADR-010 — vá lỗi N-03 "upload chặn event loop")
# ===================================================
# Kích thước mảnh khi ghi tệp tải lên (MB). Nhỏ = event loop mượt hơn, lớn = ít chuyển thread hơn.
UPLOAD_CHUNK_MB=1

# ===================================================
# DANH TÍNH & PHÂN QUYỀN (ADR-012 — vá lỗ hổng N-01 "không có xác thực")
# ===================================================
# ⚠️ QUY TRÌNH BẬT BA NẤC — KHÔNG rút gọn (xem ADR-012 mục 2):
#   off     Hành vi như trước khi có xác thực. Tạo tài khoản, tập huấn cán bộ ở nấc này.
#   shadow  Vẫn phục vụ, nhưng GHI CẢNH BÁO mỗi request thiếu xác thực (kind='auth_missing').
#           → Chạy ÍT NHẤT 1 TUẦN. Đọc cảnh báo, sửa hết chỗ còn sót (script cá nhân, n8n, tab cũ).
#           → Điều kiện sang 'on': 0 cảnh báo trong 48 GIỜ LIÊN TIẾP.
#   on      Chặn thật. Lùi lại 'shadow' bất cứ lúc nào — chỉ đổi biến này, không build lại image.
AUTH_MODE=off

# Nền tảng xác thực: local (mặc định) | ldap | oidc (chưa hiện thực — sẽ thêm mà không sửa nơi gọi)
AUTH_BACKEND=local

# Tạo quản trị viên ĐẦU TIÊN lúc khởi động. Chỉ tạo khi CHƯA có admin nào, và buộc đổi mật khẩu ở
# lần đăng nhập đầu. KHÔNG có mật khẩu mặc định: để trống ADMIN_BOOTSTRAP_PASSWORD thì không tạo gì.
# ⚠️ XÓA hai dòng này khỏi cấu hình sau khi đã đăng nhập và đổi mật khẩu.
ADMIN_BOOTSTRAP_USER=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FULLNAME=Quản trị hệ thống

# Phiên đăng nhập
SESSION_TTL_HOURS=12
SESSION_COOKIE_NAME=docuflow_session
# Bật khi đã có HTTPS. Bật lúc còn chạy HTTP sẽ làm đăng nhập IM LẶNG không hoạt động.
SESSION_COOKIE_SECURE=0

# Chính sách mật khẩu (YC-QT-06)
PASSWORD_MIN_LENGTH=10
PASSWORD_PBKDF2_ITERATIONS=600000
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Chốt bốn mắt (QĐ-05): 0 = người có quyền duyệt được duyệt mọi tài liệu, KỂ CẢ tài liệu do mình
# tải lên (mặc định, phù hợp khi Trung tâm ít nhân sự). Bật 1 khi đủ người.
REQUIRE_SEPARATE_APPROVER=0

# CORS: để TRỐNG khi giao diện gọi API qua proxy same-origin (mặc định).
# ⚠️ KHÔNG dùng "*" — trình duyệt từ chối gửi cookie phiên tới nguồn dùng ký tự thay thế.
CORS_ORIGINS=

# ===================================================
# END OF CONFIGURATION
# ===================================================
