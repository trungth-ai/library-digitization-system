# ===================================================
# Library Digitization System - .gitignore
# ===================================================

# ============ SECRETS / ENV (KHÔNG BAO GIỜ commit) ============
.env
.env.*
!.env.example
ui/.env
ui/.env.*
!ui/.env.example
*.pem
*.key
secrets/

# ============ PYTHON ============
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ============ NODE / NEXT.JS ============
node_modules/
/ui/node_modules/
.next/
/ui/.next/
out/
/ui/out/
.turbo/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ============ DỮ LIỆU RUNTIME (job data, output số hóa) ============
data/
/data/digitization/
configs/*
!configs/.gitkeep
logs/
*.log

# ============ DOCKER / VOLUMES ============
postgres_data/
redis_data/
n8n_data/
grafana_data/
filebrowser_data/

# ============ OS / IDE ============
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# ============ EVAL (đo đạc) ============
# Tài liệu thật để đo có thể nhạy cảm → KHÔNG commit. Mẫu nằm ở scripts/eval/samples/.
eval_data/
eval_out/

# ============ TẠM ============
tmp/
temp/
*.tmp

# ---------------------------------------------------------------------
# RÀO CHẮN: đây là repo của HỆ THỐNG SỐ HÓA TÀI LIỆU.
# Ngày 29/07/2026 một dự án khác (hệ đối sánh CTĐT) bị push nhầm vào đây, kèm 272 MB
# tài liệu thật trong `uploads/`. Các mẫu dưới đây để lần sau `git add .` không kéo
# theo nữa. KHÔNG BAO GIỜ commit tài liệu thật vào repo — dữ liệu số hóa nằm ở
# volume ngoài (DIGITIZE_DATA_DIR), không nằm trong mã nguồn.
# ---------------------------------------------------------------------
uploads/
/app/
/migrations/
/alembic.ini
/run.py
/config.py
/entrypoint.sh
/dev_data*.sql
/docker-compose.prod.yml
