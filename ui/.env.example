# ===================================================
# UI (Next.js) - Environment Config mẫu
# Copy thành .env rồi điền giá trị thật. KHÔNG commit .env.
# ---------------------------------------------------
# LƯU Ý: các biến NEXT_PUBLIC_* được nhúng vào bundle lúc BUILD
# và lộ ra phía client. Đặt đúng URL mà TRÌNH DUYỆT truy cập được
# (IP/domain thật của server), không phải tên service nội bộ Docker.
# ===================================================

# URL công khai của DSpace
NEXT_PUBLIC_DSPACE_URL=https://lib.hpu.edu.vn

# Claude API key (dùng server-side cho AI gợi ý collection)
# CHÚ Ý: đúng tên biến là CLAUDE_API_KEY (viết HOA), code đọc process.env.CLAUDE_API_KEY
CLAUDE_API_KEY=sk-ant-your-claude-api-key-here

# URL backend FastAPI OCR (trình duyệt phải truy cập được URL này)
NEXT_PUBLIC_OCR_API_URL=http://10.1.1.101:8000

# URL site (dùng cho SSR self-fetch)
NEXT_PUBLIC_SITE_URL=http://10.1.1.101:3000

# PostgreSQL (nếu UI cần truy cập trực tiếp)
DATABASE_URL=postgresql://libraryuser:change_me@10.1.1.101:5432/library_digitization

# Node environment
NODE_ENV=development
